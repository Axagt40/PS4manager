# The app writes these next to the script while you use it. They hold your own
# PS4's details (address, saved plugins, game names) and must never be published.
ps4_manager_config.json
title_cache.json
plugins.ini
backups/

# The test suites stay local on purpose: the app needs neither to run, so they
# are not published. (They still run normally here - git just ignores them.)
test_ps4_manager.py
test_live_ps4.py

# Python bytecode and caches
__pycache__/
*.py[cod]

# Logs and scratch files
*.log
*.tmp

# Editors / OS
.vscode/
.idea/
.DS_Store
